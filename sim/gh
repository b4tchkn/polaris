#!/bin/bash
# Fake gh for the simulation: keeps pull requests as files under $GH_DATA and never talks to GitHub.
D="${GH_DATA:-/work/github}"; mkdir -p "$D/prs"
printf '%s gh' "$(date +%T)" >> "$D/calls.log"; printf ' %q' "$@" >> "$D/calls.log"; echo >> "$D/calls.log"
URL=https://github.example/sim/tt/pull
num() { n="${1##*/}"; n="${n#\#}"; [ -d "$D/prs/$n" ] && echo "$n" || { echo "fake gh: no pull request $1" >&2; exit 1; }; }
# The pull request a pr subcommand names (number, #n, or URL), else the one whose head is the current branch.
pick() {
  shift 2; for a in "$@"; do case "$a" in [0-9]*|\#[0-9]*|http*) num "$a"; return ;; esac; done
  b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  for p in $(ls "$D/prs"); do [ "$(cat "$D/prs/$p/head")" = "$b" ] && { echo "$p"; return; }; done
  echo "fake gh: no pull request for branch $b" >&2; return 1
}
has_q() { for a in "$@"; do case "$a" in -q|--jq) return 0 ;; esac; done; return 1; }

case "$1 $2" in
  "auth status") echo "Logged in to github.example as sim"; exit 0 ;;
  "repo view") echo "sim/tt"; exit 0 ;;
  "pr create")
    shift 2; head=""; title=""; body=""
    while [ $# -gt 0 ]; do case "$1" in
      --head|-H) head="$2"; shift 2 ;; --title|-t) title="$2"; shift 2 ;;
      --body|-b) body="$2"; shift 2 ;; --body-file|-F) body=$(cat "$2") || exit 1; shift 2 ;;
      --base|-B) shift 2 ;; --draft|-d|--fill) shift ;; *) echo "fake gh: pr create: unsupported $1" >&2; exit 1 ;;
    esac; done
    [ -n "$head" ] || head=$(git rev-parse --abbrev-ref HEAD)
    git ls-remote --exit-code --heads origin "$head" >/dev/null 2>&1 || { echo "fake gh: branch $head is not pushed" >&2; exit 1; }
    n=$(( $(ls "$D/prs" | wc -l) + 1 )); mkdir "$D/prs/$n"
    printf '%s' "$head" > "$D/prs/$n/head"; printf '%s' "$title" > "$D/prs/$n/title"
    printf '%s' "$body" > "$D/prs/$n/body"; echo OPEN > "$D/prs/$n/state"; : > "$D/prs/$n/merge"
    echo "$URL/$n" ;;
  "pr list")
    for p in $(ls "$D/prs" | sort -n); do
      d="$D/prs/$p"; st=$(cat "$d/state")
      if has_q "$@"; then
        # Same rows as gdd-status.sh's jq: "Refine:" for a refinement, else the Sub-goal path; then state and url.
        if grep -q '^Refine:' "$d/body"; then s="Refine:"
        else s=$(sed -n 's/^Sub-goal: *\([^[:space:]]*\).*/\1/p' "$d/body" | head -1); fi
        [ -n "$s" ] && printf '%s\t%s\t%s\n' "$s" "$st" "$URL/$p" || true
      else
        printf '%s\t%s\t%s\t%s\n' "$p" "$(cat "$d/title")" "$(cat "$d/head")" "$st"
      fi
    done ;;
  "pr view")
    n=$(num "$3"); d="$D/prs/$n"
    if has_q "$@"; then cat "$d/state"
    else printf 'title:\t%s\nstate:\t%s\nurl:\t%s\nhead:\t%s\n--\n%s\n' "$(cat "$d/title")" "$(cat "$d/state")" "$URL/$n" "$(cat "$d/head")" "$(cat "$d/body")"; fi ;;
  "pr edit")
    n=$(pick "$@") || exit 1; d="$D/prs/$n"; shift 2
    while [ $# -gt 0 ]; do case "$1" in
      --title|-t) printf '%s' "$2" > "$d/title"; shift 2 ;; --body|-b) printf '%s' "$2" > "$d/body"; shift 2 ;;
      --body-file|-F) b=$(cat "$2") || exit 1; printf '%s' "$b" > "$d/body"; shift 2 ;;
      -*) echo "fake gh: pr edit: unsupported $1" >&2; exit 1 ;; *) shift ;;
    esac; done
    echo "$URL/$n" ;;
  "pr checks")
    # The CI stand-in: runs the gate (Definition of done Checks in gdd/goal.md) on the pull request's branch.
    n=$(pick "$@") || exit 1; t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
    git clone -q -b "$(cat "$D/prs/$n/head")" /work/remote.git "$t/pr" || exit 1; cd "$t/pr"
    gates=$(awk '/^## /{d=($0=="## Definition of done")} d' gdd/goal.md | sed -n 's/.*Check: `\(.*\)`.*/\1/p')
    [ -n "$gates" ] || { printf 'gate\tfail\tno gate in gdd/goal.md\n'; exit 1; }
    while read -r g; do bash -c "$g" > "$t/out" 2>&1 || { printf 'gate\tfail\t%s\n' "$g"; tail -5 "$t/out"; exit 1; }; done <<< "$gates"
    printf 'gate\tpass\n' ;;
  "pr merge") n=$(pick "$@") || exit 1; exec sim-merge "$n" ;;
  "api "*)
    path="$2"; shift 2; f="$D/api-$(date +%s%N).txt"; echo "$path" > "$f"
    while [ $# -gt 0 ]; do case "$1" in
      --input) [ "$2" = - ] && cat >> "$f" || cat "$2" >> "$f"; shift 2 ;;
      *) echo "$1" >> "$f"; shift ;;
    esac; done
    echo '{"id":1}' ;;
  *) echo "fake gh: unsupported: gh $*" >&2; exit 1 ;;
esac
